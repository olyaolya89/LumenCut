# Copy to .env and fill what you use. Existing shell env always wins.
# npm run dev loads this file.

# Paid piece — pick ONE. Search, ffmpeg, Edge TTS stay free either way.
#   gemini  — free Google AI Studio key (default if this is set)
#   grok    — xAI (Imagine stills + Grok analysis)
#   ollama  — local models, no cloud bill
LLM_PROVIDER=gemini

GEMINI_API_KEY=
XAI_API_KEY=
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2

# Free stock (at least one recommended)
PEXELS_API_KEY=
PIXABAY_API_KEY=
UNSPLASH_ACCESS_KEY=

# Optional
ELEVENLABS_API_KEY=
YOUTUBE_DATA_API_KEY=
SERPAPI_KEY=

# Local / free defaults
TTS_DEFAULT=edge
RENDER_ENGINE=ffmpeg
DATA_DIR=./data
MAX_CLIP_MS=5000
CONCURRENT_DOWNLOADS=6
